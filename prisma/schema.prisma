generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  password    String?   // Add this for credentials sign-in
  image       String?
  givenName   String?
  familyName  String?
  school      String?   // Add this for optional school/institution
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  settings    Settings?
  sessions    Session[]
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  sessionCode    String    @unique
  title          String
  presentationId String?
  studentCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students SessionStudent[]
}

// A student who joined a session, captured at session end for the gradebook.
model SessionStudent {
  id        String          @id @default(cuid())
  sessionId String
  name      String
  score     Int             @default(0) // coding questions answered correctly
  total     Int             @default(0) // number of coding questions in the deck
  joinedAt  DateTime        @default(now())

  session Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers SessionAnswer[]

  @@index([sessionId])
}

// One coding-question slide's work for a student: their code, output, pass/fail.
model SessionAnswer {
  id               String    @id @default(cuid())
  sessionStudentId String
  slideIndex       Int
  code             String    @default("")
  output           String    @default("")
  passed           Boolean? // null = not autograded (no expected output, or never run)
  ranAt            DateTime?

  student SessionStudent @relation(fields: [sessionStudentId], references: [id], onDelete: Cascade)

  @@index([sessionStudentId])
}

model Settings {
  id             String   @id @default(cuid())
  userId         String   @unique
  theme          String   @default("system")
  editorFontSize Int      @default(14)
  lockDefault    Boolean  @default(false)
  slidesPerPage  Int      @default(1)
  json           Json     @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}